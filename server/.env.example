# 复制成 .env 后按需填写（.env 不入库）。ASR_* / LLM_* 不填时回落到 OPENAI_*。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

TTS_VOICE=zh-CN-XiaoxiaoNeural

# 设备连接时带 ?token=...；留空表示不校验
DEVICE_TOKEN=

# MOCK=1 时跳过 ASR 和 LLM，只走真实的 edge-tts，用来测协议
MOCK=
